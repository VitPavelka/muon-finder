      "near_apex_radius_pts": 2
    },
    "residual_threshold": {
      "enabled": true,
      "median_window": 3,
      "threshold_noise_factor": 3.0
    },
    "edge_variants": {
      "enabled": true,
      "noise_level_step_factor": 1.0,
      "noise_level_start_factor": 0.0,
      "max_noise_levels": 50
