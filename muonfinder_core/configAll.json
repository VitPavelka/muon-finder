    "missing_policy": "review",
    "pce_dead_zone_enabled": false,
    "pce_dead_zone_low": -0.8,
    "pce_dead_zone_high": -0.2
  },
  "ss5": {
    "ss1_threshold": 0.95,
    "pce_spike_min": 0.5,
    "edge_spike_max": -0.5
