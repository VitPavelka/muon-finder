    "signal_source": "raw",
    "median_windows": [3, 5, 7, 9, 13, 17, 21, 31],
    "curve_windows": [3, 5, 7, 9, 13, 17],
    "early_windows": [3, 5, 7],
    "mid_windows": [9, 13, 17],
    "late_windows": [17, 21, 31],
    "late_reference_window": 31,
    "min_prominence": 1e-12,
    "eps": 1e-12
  },
  "experimental_features": {
