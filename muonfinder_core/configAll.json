  "background": {
    "method": "bg_mad"
  },
  "noise": {
    "noise_source": "morph_range",
    "noise_height_factor": 3.0,
    "candidate_noise_prefilter_enabled": true,
    "candidate_noise_prefilter_mode": "morph_range_chord",
