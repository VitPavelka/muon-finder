    "threshold_k_mad": 20.0,
    "threshold_min_abs": null,
    "k_mad_pixel": 8.0,
    "min_peak": 80.0,
    "max_width_pts": 24,
    "pad_pts": 0,
    "edge_k_mad": 2.0,
    "merge_duplicate_segments": true,
